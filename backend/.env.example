# MongoDB connection string (MongoDB Atlas free tier works fine)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=replace_with_a_long_random_string

# JWT expiry (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional - defaults to gemini-2.0-flash if not set
GEMINI_MODEL=gemini-2.0-flash

# Node environment
NODE_ENV=development

# --- Udhaar reminder delivery ---

# TextBee (Android SMS gateway) - get these from your textbee.dev dashboard
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=your_textbee_device_id

# Gmail API (sends over HTTPS, not SMTP)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GMAIL_SENDER_EMAIL=your_sender_email@gmail.com
